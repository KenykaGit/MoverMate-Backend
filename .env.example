# Copy to .env and adjust. Read by the app (pydantic-settings) and by docker compose.
# Nested settings use "__": DATABASE__URL, AUTH__SECRET_KEY, RATE_LIMIT__API_PER_MINUTE...
ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=["http://localhost:3000"]

# Used by docker compose for the db container.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Host-side URLs, for `make run` / `make migrate` against `make infra`.
DATABASE__URL=postgresql+asyncpg://app:app@localhost:5432/app
REDIS__URL=redis://localhost:6379/0

# In prod AUTH__SECRET_KEY is mandatory (>= 32 random characters):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH__SECRET_KEY=dev-only-insecure-secret-key-change-me!!
AUTH__ACCESS_TOKEN_TTL=PT15M
AUTH__REFRESH_TOKEN_TTL=P30D

RATE_LIMIT__API_PER_MINUTE=120
RATE_LIMIT__AUTH_PER_MINUTE=10
IDEMPOTENCY__PENDING_TTL_SECONDS=30
IDEMPOTENCY__COMPLETED_TTL_SECONDS=86400
