# Local development. Copy to .env and adjust; every key is optional (defaults live in
# src/app/config.py and docker-compose.yml). Never read by tests or by the api image.
# Read by: docker compose (variable substitution) and the app/alembic on the host
# (`make run`, `make migrate`) via pydantic-settings.
# Nested settings use "__": DATABASE__URL, AUTH__SECRET_KEY, RATE_LIMIT__API_PER_MINUTE...
# Production keys are listed in docker-compose.prod.yml; the deploy job writes that .env.

# --- Passed to the api container by `make up` and used by `make run` ---
ENV=local
LOG_LEVEL=INFO
# Default is true (JSON); plain text is easier to read locally.
LOG_JSON=false
# Register test accounts (test_1 ... test_5)
# with demo projects on api startup; the password is in app/application/seed/catalog.py.
SEED_TEST_USERS=true
# Empty: the public password from the catalog. In prod it must be set (ADR 0018).
SEED_TEST_PASSWORD=
# The frontend dev server opened directly on :3000. Via nginx (:8000) it is same-origin.
CORS_ORIGINS=["http://localhost:3000"]
# In prod AUTH__SECRET_KEY is mandatory (>= 32 random characters):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH__SECRET_KEY=dev-only-insecure-secret-key-change-me!!
RATE_LIMIT__API_PER_MINUTE=120
RATE_LIMIT__AUTH_PER_MINUTE=10
RATE_LIMIT__SCAN_PER_MINUTE=10
# Photo scanning (POST /api/v1/projects/{id}/items/scan) through the Spirit LLM proxy:
# an API key of the proxy account. Empty: scanning answers 503, everything else works.
# Check the key and the model: `make llm-check` (a short text request, prints the answer).
LLM__API_KEY=
LLM__SCAN_MODEL=openrouter/claude-haiku-5-5
# Web Push contact (the VAPID `sub` claim) for the worker: mailto: or https://.
PUSH__VAPID_SUBJECT=mailto:admin@example.com

# --- docker compose only: the db container and host ports of `make infra` ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# --- Host only (`make run` / `make migrate` against `make infra`) ---
# Inside compose the api always talks to db:5432 and redis:6379, so these are ignored there.
# Keep the ports in sync with *_HOST_PORT above.
DATABASE__URL=postgresql+asyncpg://app:app@localhost:5432/app
REDIS__URL=redis://localhost:6379/0
# Not forwarded to the container: to change them under `make up`, add them to
# x-app-env in docker-compose.yml.
AUTH__ACCESS_TOKEN_TTL=PT15M
AUTH__REFRESH_TOKEN_TTL=P30D
IDEMPOTENCY__PENDING_TTL_SECONDS=30
IDEMPOTENCY__COMPLETED_TTL_SECONDS=86400
# The worker on the host (needs `make infra`), two processes:
#   uv run taskiq worker app.worker.entry:broker --no-configure-logging --workers 1
#   uv run taskiq scheduler app.worker.entry:scheduler --no-configure-logging
# Without a key it creates one in PUSH__VAPID_KEY_FILE (default .vapid/private_key.pem,
# git-ignored) on first send.
WORKER__INTERVAL_SECONDS=15
# Another OpenAI-compatible API instead of the proxy (not forwarded by compose).
LLM__BASE_URL=https://llm-proxy.spirit.t-education.com/v1
LLM__TIMEOUT_SECONDS=30
